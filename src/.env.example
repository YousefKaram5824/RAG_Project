# =============================================================================
# src/.env.example — Application Environment Variables Template
# =============================================================================
# INSTRUCTIONS:
#   1. Copy this file:  copy .env.example .env        (Windows CMD)
#                  or:  cp .env.example .env           (PowerShell / Git Bash)
#   2. Fill in your real API keys and settings in .env
#   3. NEVER commit .env to git — it contains secrets
#
# This file is loaded automatically by helpers/config.py via pydantic-settings.
# =============================================================================

# --- App Identity ---
APP_NAME=Mini-RAG
APP_VERSION=0.1.0

# --- File Upload Settings ---
FILE_ALLOWED_EXTENSIONS=["text/plain", "application/pdf"]
FILE_MAX_SIZE_MB=10
FILE_CHUNK_SIZE=512000

# --- MongoDB (must match docker/.env credentials) ---
# Format: mongodb://USERNAME:PASSWORD@HOST:PORT
MONGODB_URI=mongodb://admin:admin123@localhost:27007
MONGODB_DB_NAME=mini_rag_db

# --- OpenAI / LLM Provider ---
# For real OpenAI:  OPENAI_API_BASE=https://api.openai.com/v1
# For Ollama local: OPENAI_API_BASE=http://localhost:11434/v1
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_BASE=https://api.openai.com/v1

# --- Model Names ---
# Generation model (text answers). Examples:
#   OpenAI:  gpt-4o-mini
#   Ollama:  gemma2:9b-instruct-q5_0
GENERATE_RESPONSE_MODEL=gpt-4o-mini

# Embedding model — local sentence-transformers model
# BAAI/bge-small-en produces 384-dimensional vectors, fast and efficient
EMBEDDINGS_MODEL=BAAI/bge-small-en
EMBEDDING_DIMENSION=384

# --- Generation Settings ---
MAX_INPUT_TOKENS=1000       # Max characters fed into the LLM context window
MAX_RESPONSE_TOKENS=500     # Max tokens the LLM returns per answer
TEMPERATURE=0.1             # Low temperature = more factual, less creative answers

# --- Qdrant Vector DB ---
VECTOR_DB_PATH=assets/db/qdrant_data      # Path on disk for Qdrant local storage
VECTOR_DISTANCE_METRIC=Cosine             # Cosine similarity is standard for text embeddings
