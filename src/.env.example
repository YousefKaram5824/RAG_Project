APP_NAME=Mini-RAG
APP_VERSION=0.1.0

FILE_ALLOWED_EXTENSIONS=["text/plain", "application/pdf"]
FILE_MAX_SIZE_MB=10
FILE_CHUNK_SIZE=512000

MONGODB_URI=mongodb://admin:admin123@localhost:27007
MONGODB_DB_NAME=mini_rag_db

GROQ_API_KEY=your-api-key
GROQ_API_BASE=https://api.groq.com/openai/v1
GENERATE_RESPONSE_MODEL=llama-3.1-8b-instant
ALT_GENERATE_RESPONSE_MODEL=llama3-70b-8192

EMBEDDINGS_MODEL=BAAI/bge-small-en
EMBEDDING_DIMENSION=384

MAX_INPUT_TOKENS=1000
MAX_RESPONSE_TOKENS=500
TEMPERATURE=0.1

VECTOR_DB_PATH=assets/db/qdrant_data
VECTOR_DISTANCE_METRIC=Cosine
