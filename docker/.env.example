# =============================================================================
# docker/.env.example — Docker Environment Variables Template
# =============================================================================
# INSTRUCTIONS:
#   1. Copy this file:  copy .env.example .env        (Windows CMD)
#                  or:  cp .env.example .env           (PowerShell / Git Bash)
#   2. Fill in real values in .env (never commit .env to git)
#
# These variables are ONLY used by docker-compose.yaml to configure MongoDB.
# =============================================================================

MONGO_USER=admin
MONGO_PASSWORD=your_secure_password_here
